@@ -0,0 +1,10 @@
+package hicli
+
+// PauseLocalSync keeps the account, crypto state and database open. Sync() owns
+// its request queue context; cancelling it also stops background key requests.
+func (h *HiClient) PauseLocalSync() {
+	h.Client.StopSync()
+	if cancel := h.stopSync.Swap(nil); cancel != nil {
+		(*cancel)()
+	}
+}
