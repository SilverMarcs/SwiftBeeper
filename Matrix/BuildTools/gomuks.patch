-// Filter ID save and load are intentionally no-ops: we want to recreate filters when restarting syncing
-
-func (h *hiStore) SaveFilterID(_ context.Context, _ id.UserID, _ string) error { return nil }
-func (h *hiStore) LoadFilterID(_ context.Context, _ id.UserID) (string, error) { return "", nil }
+// Reuse this session's filter across background/foreground sync restarts.
+func (h *hiStore) filterScope(userID id.UserID) string {
+	return fmt.Sprintf("%s|%s|%t", userID, h.Client.HomeserverURL, h.Verified)
+}
+func (h *hiStore) SaveFilterID(_ context.Context, userID id.UserID, filterID string) error {
+	h.syncFilterID, h.syncFilterScope = filterID, h.filterScope(userID)
+	return nil
+}
+func (h *hiStore) LoadFilterID(_ context.Context, userID id.UserID) (string, error) {
+	if h.syncFilterScope != h.filterScope(userID) {
+		return "", nil
+	}
+	return h.syncFilterID, nil
+}
