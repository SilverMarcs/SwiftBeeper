// Builds the client with the in-process Go backend.
RELAY_REMOTE_ONLY = NO

HEADER_SEARCH_PATHS[sdk=iphoneos*] = $(inherited) $(SRCROOT)/Frameworks/EasyMatrix.xcframework/ios-arm64/Headers
HEADER_SEARCH_PATHS[sdk=iphonesimulator*] = $(inherited) $(SRCROOT)/Frameworks/EasyMatrix.xcframework/ios-arm64_x86_64-simulator/Headers
HEADER_SEARCH_PATHS[sdk=macosx*] = $(inherited) $(SRCROOT)/Frameworks/EasyMatrix.xcframework/macos-arm64_x86_64/Headers

LIBRARY_SEARCH_PATHS[sdk=iphoneos*] = $(inherited) $(SRCROOT)/Frameworks/EasyMatrix.xcframework/ios-arm64
LIBRARY_SEARCH_PATHS[sdk=iphonesimulator*] = $(inherited) $(SRCROOT)/Frameworks/EasyMatrix.xcframework/ios-arm64_x86_64-simulator
LIBRARY_SEARCH_PATHS[sdk=macosx*] = $(inherited) $(SRCROOT)/Frameworks/EasyMatrix.xcframework/macos-arm64_x86_64

OTHER_LDFLAGS = $(inherited) -leasymatrix
